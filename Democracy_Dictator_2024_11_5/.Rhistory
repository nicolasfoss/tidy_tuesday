# Plot the map with regime categories
world_democracy_map <- world_democracy %>%
ggplot(data = world_democracy) +
geom_sf(aes(fill = regime_group), color = "grey50") +
labs(title = "World Map Colored by Regime Category",
subtitle = "Data: Xavier Marquez Democracy and Dictatorship Dataset",
caption = social_caption,
fill = "Regime Category (count)") +
theme_cleaner(base_size = 15,
base_color = "darkslategray",
title_text_size = 20,
subtitle_text_size = 18,
base_family = "Work Sans"
) +
scale_fill_paletteer_d(palette = "colorblindr::OkabeIto") +
theme(legend.position = "inside",
legend.position.inside = c(0.35, 0.5),
plot.caption = element_textbox_simple(),
panel.background = element_rect(fill = "lightblue", color = NA),
plot.background = element_rect(fill = "lightblue", color = NA)
)
